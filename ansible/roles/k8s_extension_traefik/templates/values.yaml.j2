# Traefik Helm values.
# See https://github.com/traefik/traefik-helm-chart/blob/master/traefik/values.yaml

# ── CONFIG flag ───────────────────────────────────────────────────
{# HTTPS is gated on a domain being set, https being enabled and an email
being provided. HTTPS is not yet wired up; this only exposes the flag so
future HTTPS config can be emitted conditionally. #}
{% set http_enabled = homelab.gateway.http.enabled | bool %}
{% set https_enabled = homelab.gateway.https.enabled | bool and homelab.gateway.https.email | length > 0 %}

{#The dashboard can be enabled to view reoutes, services and middlewares.
When a domain is configured it is served at <domain>/traefik/dashboard,
otherwise it is served at the host/node IP address on /traefik/dashboard.#}
{% set dashboard_enabled = homelab.monitor.traefik_dashboard.enabled %}
{% set dashboard_rule = 'PathPrefix(`/traefik`)' %}
{% if homelab.monitor.domain | length > 0 %}
{% set dashboard_rule = 'Host(`' ~ homelab.monitor.domain ~ '`) && PathPrefix(`/traefik`)' %}
{% endif %}

# ── Global ─────────────────────────────────────────────────────────
global:
  checkNewVersion: true
  sendAnonymousUsage: false
  notAppendXForwardedFor: false

# ── Access Control ─────────────────────────────────────────────────────────
rbac:
  enabled: true
  namespaced: false {# when true, it disables cluster scope resources which means that IngressClass, NodePortLB and Gateway Provider cannot work. See https://doc.traefik.io/traefik/reference/install-configuration/providers/kubernetes/kubernetes-ingress/#opt-providers-kubernetesIngress-disableClusterScopeResources #}

# ── Logging ─────────────────────────────────────────────────────────
log:
  format: json
  level: "INFO"

accessLog:
  enabled: true
  format: json

# ── Ports, Services ───────────────────────────────────────────────────────
ports:
  web:
    nodePort: 30080
    proxyProtocol:
      insecure: true
  websecure:
    nodePort: 30443
    proxyProtocol:
      insecure: true

service:
  enabled: true
  spec:
    type: NodePort

# ── TLS ───────────────────────────────────────────────────────
{% if https_enabled %}
persistence:
  enabled: false
  name: data
  accessMode: ReadWriteOnce
  size: 128Mi
  path: "{{ homelab.general.dir }}/traefik/certs"

certificatesResolvers:
  defaultCertResolver:
    acme:
      email: "{{ homelab.gateway.https.email }}"
      storage: "{{ homelab.general.dir }}/traefik/certs/acme.json"
      httpChallenge:
        entryPoint: "web"
{% endif %}

# ── Dashboard ───────────────────────────────────────────────────────
{% if dashboard_enabled %}
api:
  dashboard: true
  basePath: "/traefik"

ingressRoute:
  dashboard:
    enabled: true
    matchRule: "{{ dashboard_rule }}"
    entryPoints:
{% if https_enabled %}
      - websecure
{% endif %}
{% if http_enabled %}
      - web
{% endif %}
    middlewares:
      - name: traefik-dashboard-redirect
      - name: traefik-dashboard-auth
      - name: rate-limit
{% if https_enabled %}
      - name: https-redirect
{% endif %}
{% endif %}

# ── Extra Objects ─────────────────────────────────────────────────────────
extraObjects:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: traefik-dashboard-auth-secret
    type: kubernetes.io/basic-auth
    stringData:
      username: "{{ homelab.monitor.traefik_dashboard.auth.username }}"
      password: "{{ homelab.monitor.traefik_dashboard.auth.password }}"

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: traefik-dashboard-auth
    spec:
      basicAuth:
        secret: traefik-dashboard-auth-secret

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: traefik-dashboard-redirect
    spec:
      redirectRegex:
        regex: "\/traefik(\\/)?$"
        replacement: "/traefik/dashboard/"

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: rate-limit
    spec:
      rateLimit:
        average: 50
        period: 1s
        burst: 50

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: https-redirect
    spec:
      redirectRegex:
        regex: "^http:\/\/(.*)"
        replacement: "https://${1}"
