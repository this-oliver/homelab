# ── HTTPS flag ───────────────────────────────────────────────────
{# HTTPS is gated on a domain being set, https being enabled and an email
being provided. HTTPS is not yet wired up; this only exposes the flag so
future HTTPS config can be emitted conditionally. #}
{% set https_enabled = homelab.monitor.domain | length > 0 and homelab.gateway.https.enabled | bool and homelab.gateway.https.email | length > 0 %}

# ── Dashboard rule ───────────────────────────────────────────────────
{#The dashboard is always enabled. When a domain is configured it is
served at <domain>/traefik/dashboard, otherwise it is served at the
host/node IP address on /traefik/dashboard.#}
{% if homelab.monitor.domain | length > 0 %}
{% set dashboard_rule = 'Host(`' ~ homelab.monitor.domain ~ '`) && PathPrefix(`/`)' %}
{% else %}
{% set dashboard_rule = 'PathPrefix(`/`)' %}
{% endif %}

# ── Headlamp Helm Values ───────────────────────────────────────────────────

config:
  baseURL: "/dashboard"
  pluginsDir: /build/plugins

volumeMounts:
    - name: headlamp-plugins
      mountPath: /build/plugins

volumes:
    - name: headlamp-plugins
      emptyDir: {}

initContainers:
{% if homelab.monitor.headlamp_dashboard.trivy.enabled %}
    - command:
        - /bin/sh
        - '-c'
        - mkdir -p /build/plugins && cp -r /plugins/* /build/plugins/
      image: ghcr.io/kubebeam/trivy-headlamp-plugin:v0.3.2
      name: trivy-plugin
      volumeMounts:
        - mountPath: /build/plugins
          name: headlamp-plugins
{% endif %}

serviceAccount:
  create: true
  name: "headlamp-admin"

clusterRoleBinding:
  create: true
  clusterRoleName: cluster-admin

extraManifests:
- |
  apiVersion: traefik.io/v1alpha1
  kind: Middleware
  metadata:
    name: headlamp-redirect
  spec:
    replacePathRegex:
        regex: "^\\/$"
        replacement: "/dashboard/"
- |
  apiVersion: traefik.io/v1alpha1
  kind: IngressRoute
  metadata:
    name: headlamp
  spec:
    entryPoints:
{% if https_enabled %}
      - websecure
{% else %}
      - web
{% endif %}
    routes:
    - match: "{{ dashboard_rule }}"
      kind: Rule
      middlewares:
      - name: headlamp-redirect
      services:
      - name: "{{ helm_release.name }}"
        namespace: "{{ helm_release.namespace }}"
        port: 80
    tls:
      certResolver: defaultCertResolver
