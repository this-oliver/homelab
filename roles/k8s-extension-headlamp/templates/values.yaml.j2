# ── HTTPS flag ───────────────────────────────────────────────────
{# HTTPS is gated on a domain being set, https being enabled and an email
being provided. HTTPS is not yet wired up; this only exposes the flag so
future HTTPS config can be emitted conditionally. #}
{% set https_enabled = homelab.domain.url | length > 0 and homelab.domain.https.enabled | bool and homelab.domain.https.email | length > 0 %}

# ── Dashboard rule ───────────────────────────────────────────────────
{#The dashboard is always enabled. When a domain is configured it is
served at <domain>/traefik/dashboard, otherwise it is served at the
host/node IP address on /traefik/dashboard.#}
{% if homelab.domain.url | length > 0 %}
{% set dashboard_rule = 'Host(`' ~ homelab.domain.url ~ '`) && PathPrefix(`/' ~ helm_release.name ~ '/dashboard/`)' %}
{% else %}
{% set dashboard_rule = 'PathPrefix(`/' ~ helm_release.name ~ '/dashboard/`)' %}
{% endif %}

# ── Headlamp Helm Values ───────────────────────────────────────────────────

config:
  baseURL: "/{{ helm_release.name }}/dashboard"
  pluginsDir: /build/plugins

volumeMounts:
    - name: headlamp-plugins
      mountPath: /build/plugins

volumes:
    - name: headlamp-plugins
      emptyDir: {}

initContainers:
    - command:
        - /bin/sh
        - '-c'
        - mkdir -p /build/plugins && cp -r /plugins/* /build/plugins/
      image: ghcr.io/kubebeam/trivy-headlamp-plugin:v0.3.2
      name: trivy-plugin
      volumeMounts:
        - mountPath: /build/plugins
          name: headlamp-plugins

serviceAccount:
  # -- Specifies whether a service account should be created
  create: true
  # -- Annotations to add to the service account
  annotations: {}
  # -- The name of the service account to use.(If not set and create is true, a name is generated using the fullname template)
  name: "headlamp-admin"

clusterRoleBinding:
  # -- Specified whether a cluster role binding should be created
  create: true
  # -- Set name of the Cluster Role with limited permissions from you cluster
  # for example - clusterRoleName: user-ro
  clusterRoleName: cluster-admin

# -- Additional Kubernetes manifests to be deployed. Include the manifest as nested YAML.
extraManifests:
- |
  apiVersion: traefik.io/v1alpha1
  kind: IngressRoute
  metadata:
    name: headlamp
  spec:
    entryPoints:
{% if https_enabled %}
      - websecure
{% else %}
      - web
{% endif %}
    routes:
    - match: "{{ dashboard_rule }}"
      kind: Rule
      services:
      - name: "{{ helm_release.name }}"
        namespace: "{{ helm_release.namespace }}"
        port: 80
    tls:
      certResolver: defaultCertResolver
