apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt
spec:
  acme:
    email: {{ homelab.domain.https.email }}
    server: https://acme-v02.api.letsencrypt.org/directory
    privateKeySecretRef:
      name: letsencrypt-account-key
    solvers:
      - http01:
          gatewayHTTPRoute:
            parentRefs:
              - name: {{ helm_release.name }}
                namespace: {{ helm_release.namespace }}
                kind: Gateway
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-stg
spec:
  acme:
    email: {{ homelab.domain.https.email }}
    server: https://acme-staging-v02.api.letsencrypt.org/directory
    privateKeySecretRef:
      name: letsencrypt-account-key-stg
    solvers:
      - http01:
          gatewayHTTPRoute:
            parentRefs:
              - name: {{ helm_release.name }}
                namespace: {{ helm_release.namespace }}
                kind: Gateway
