# Traefik Helm values.
# See https://github.com/traefik/traefik-helm-chart/blob/master/traefik/values.yaml

# ── Dashboard rule ───────────────────────────────────────────────────
# The dashboard is always enabled. When a domain is configured it is
# served at <domain>/traefik/dashboard, otherwise it is restricted to
# clients on the same subnet as the cluster node.
{% if homelab.domain.name | length > 0 %}
{% set traefik_dashboard_rule = 'Host(`' ~ homelab.domain.name ~ '`) && (PathPrefix(`/traefik/api`) || PathPrefix(`/traefik/dashboard`))' %}
{% else %}
{% set traefik_dashboard_rule = 'ClientIP(`' ~ ansible_facts['default_ipv4']['network'] ~ '/' ~ ansible_facts['default_ipv4']['prefix'] ~ '`) && (PathPrefix(`/traefik/api`) || PathPrefix(`/traefik/dashboard`))' %}
{% endif %}

# ── Providers ───────────────────────────────────────────────────────
providers:
  kubernetesGateway:
    enabled: true

# ── Gateway ─────────────────────────────────────────────────────────
gateway:
  enabled: true
  listeners:
    web:
      port: 8000
      protocol: HTTP
      namespacePolicy:
        from: All

# ── Dashboard ───────────────────────────────────────────────────────
api:
  basePath: "/traefik"

ingressRoute:
  dashboard:
    enabled: true
    matchRule: "{{ traefik_dashboard_rule }}"
    entryPoints:
      - web
    middlewares:
      - name: traefik-dashboard-ratelimit
      - name: traefik-dashboard-auth

# ── Logging ─────────────────────────────────────────────────────────
log:
  format: json

accessLog:
  enabled: true

# ── Extra Objects ─────────────────────────────────────────────────────────
extraObjects:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: traefik-dashboard-auth-secret
    type: kubernetes.io/basic-auth
    stringData:
      username: "{{ homelab.admin.username }}"
      password: "{{ homelab.admin.password }}"
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: traefik-dashboard-auth
    spec:
      basicAuth:
        secret: traefik-dashboard-auth-secret
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: traefik-dashboard-ratelimit
    spec:
      rateLimit:
        average: 50
        period: 1s
        burst: 50
