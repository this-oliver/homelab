# Traefik Helm values.
# See https://github.com/traefik/traefik-helm-chart/blob/master/traefik/values.yaml

# ── Providers ───────────────────────────────────────────────────────
providers:
  kubernetesGateway:
    enabled: true

# ── Gateway ─────────────────────────────────────────────────────────
gateway:
  enabled: true
  listeners:
    web:
      port: 8000
      protocol: HTTP
      namespacePolicy:
        from: All

# ── Dashboard ───────────────────────────────────────────────────────
ingressRoute:
  dashboard:
    enabled: {{ traefik_dashboard_ingress_rule != "" }}
    matchRule: {{ traefik_dashboard_ingress_rule }}
    entryPoints:
      - web

# ── Logging ─────────────────────────────────────────────────────────
log:
  format: json

accessLog:
  enabled: true
