# Traefik Helm values.
# See https://github.com/traefik/traefik-helm-chart/blob/master/traefik/values.yaml

# ── HTTPS flag ───────────────────────────────────────────────────
{# HTTPS is gated on a domain being set, https being enabled and an email
being provided. HTTPS is not yet wired up; this only exposes the flag so
future HTTPS config can be emitted conditionally. #}
{% set https_enabled = homelab.domain.url | length > 0 and homelab.domain.https.enabled | bool and homelab.domain.https.email | length > 0 %}

# ── Dashboard rule ───────────────────────────────────────────────────
{#The dashboard is always enabled. When a domain is configured it is
served at <domain>/traefik/dashboard, otherwise it is served at the
host/node IP address on /traefik/dashboard.#}
{% if homelab.domain.url | length > 0 %}
{% set dashboard_rule = 'Host(`' ~ homelab.domain.url ~ '`) && (PathPrefix(`/' ~ helm_release.name ~ '/api`) || PathPrefix(`/' ~ helm_release.name ~ '/dashboard`))' %}
{% else %}
{% set dashboard_rule = '(PathPrefix(`/' ~ helm_release.name ~ '/api`) || PathPrefix(`/' ~ helm_release.name ~ '/dashboard`))' %}
{% endif %}

# ── Global ─────────────────────────────────────────────────────────
global:
  checkNewVersion: true
  sendAnonymousUsage: false

# ── Service ───────────────────────────────────────────────────────
service:
  spec:
    type: NodePort

# ── Ports ───────────────────────────────────────────────────────
ports:
  web:
    nodePort: 30080
    proxyProtocol:
      insecure: true
{% if https_enabled %}
    http:
      redirections:
        entrypoint:
          to: websecure
{% endif %}
  websecure:
    nodePort: 30443
    proxyProtocol:
      insecure: true

# ── TLS ───────────────────────────────────────────────────────
{% if https_enabled %}
persistence:
  enabled: true
  name: data
  accessMode: ReadWriteOnce
  size: 128Mi
  path: "{{ homelab.dir }}/traefik/certs"

certificatesResolvers:
  defaultCertResolver:
    acme:
      email: "{{ homelab.domain.https.email }}"
      storage: "{{ homelab.dir }}/traefik/certs/acme.json"
      httpChallenge:
        entryPoint: "web"
{% endif %}

# ── Dashboard ───────────────────────────────────────────────────────
api:
  dashboard: true
  basePath: "/traefik"

ingressRoute:
  dashboard:
    enabled: true
    matchRule: "{{ dashboard_rule }}"
    entryPoints:
{% if https_enabled %}
      - websecure
{% else %}
      - web
{% endif %}
    middlewares:
      - name: traefik-dashboard-redirect
      - name: traefik-dashboard-auth
      - name: rate-limit
{% if https_enabled %}
      - name: https-redirect
{% endif %}

# ── Logging ─────────────────────────────────────────────────────────
log:
  format: json

accessLog:
  enabled: true

# ── Extra Objects ─────────────────────────────────────────────────────────
extraObjects:
  - apiVersion: v1
    kind: Secret
    metadata:
        name: traefik-dashboard-auth-secret
    type: kubernetes.io/basic-auth
    stringData:
        username: "{{ homelab.admin.username }}"
        password: "{{ homelab.admin.password }}"

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
        name: traefik-dashboard-auth
    spec:
        basicAuth:
            secret: traefik-dashboard-auth-secret

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
        name: traefik-dashboard-redirect
    spec:
        redirectRegex:
            regex: "\/traefik\/dashboard$"
            replacement: "/traefik/dashboard/"

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
        name: rate-limit
    spec:
        rateLimit:
            average: 50
            period: 1s
            burst: 50

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
        name: https-redirect
    spec:
        redirectRegex:
            regex: "^http:\/\/(.*)"
            replacement: "https://${1}"
