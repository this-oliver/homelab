# Traefik Helm values.
# See https://github.com/traefik/traefik-helm-chart/blob/master/traefik/values.yaml

# ── CONFIG flag ───────────────────────────────────────────────────
{# HTTPS is gated on a domain being set, https being enabled and an email
being provided. HTTPS is not yet wired up; this only exposes the flag so
future HTTPS config can be emitted conditionally. #}
{% set https_enabled = homelab.domain.url | length > 0 and homelab.domain.https.enabled | bool and homelab.domain.https.email | length > 0 %}

{#The dashboard is always enabled. When a domain is configured it is
served at <domain>/traefik/dashboard, otherwise it is served at the
host/node IP address on /traefik/dashboard.#}
{% if homelab.domain.url | length > 0 %}
{% set dashboard_rule = 'Host(`' ~ homelab.domain.url ~ '`) && PathPrefix(`/traefik`)' %}
{% else %}
{% set dashboard_rule = 'PathPrefix(`/traefik`)' %}
{% endif %}

# ── Global ─────────────────────────────────────────────────────────
global:
  checkNewVersion: true
  sendAnonymousUsage: false
  notAppendXForwardedFor: false

# ── Access Control ─────────────────────────────────────────────────────────
rbac:
  enabled: true
  {#-- When set to true: <br />
  1. It switches respectively the use of `ClusterRole` and `ClusterRoleBinding` to `Role` and `RoleBinding`.<br />
  2. It adds `disableClusterScopeResources` on Ingress and CRD (Kubernetes) providers<br />
  **NOTE**: `IngressClass`, `NodePortLB` and **Gateway** provider cannot be used with namespaced RBAC. <br />
  See [upstream documentation](https://doc.traefik.io/traefik/reference/install-configuration/providers/kubernetes/kubernetes-ingress/#opt-providers-kubernetesIngress-disableClusterScopeResources) for more details.#}
  namespaced: false
  secretResourceNames: []

serviceAccount:
    name: "traefik"

# ── Logging ─────────────────────────────────────────────────────────
log:
    format: json
    level: "INFO"

accessLog:
    enabled: true
    format: json

# ── Ports, Services ───────────────────────────────────────────────────────
ports:
  web:
    nodePort: 30080
    proxyProtocol:
      insecure: true
  websecure:
    nodePort: 30443
    proxyProtocol:
      insecure: true

service:
  enabled: true
  spec:
    type: NodePort

# ── TLS ───────────────────────────────────────────────────────
{% if https_enabled %}
persistence:
  enabled: false
  name: data
  accessMode: ReadWriteOnce
  size: 128Mi
  path: "{{ homelab.dir }}/traefik/certs"

certificatesResolvers:
  defaultCertResolver:
    acme:
      email: "{{ homelab.domain.https.email }}"
      storage: "{{ homelab.dir }}/traefik/certs/acme.json"
      httpChallenge:
        entryPoint: "web"
{% endif %}

# ── Dashboard ───────────────────────────────────────────────────────
api:
  dashboard: true
  basePath: "/traefik"

ingressRoute:
  dashboard:
    enabled: true
    matchRule: "{{ dashboard_rule }}"
    entryPoints:
{% if https_enabled %}
      - websecure
{% else %}
      - web
{% endif %}
    middlewares:
      - name: traefik-dashboard-redirect
      - name: traefik-dashboard-auth
      - name: rate-limit
{% if https_enabled %}
      - name: https-redirect
{% endif %}

# ── Extra Objects ─────────────────────────────────────────────────────────
extraObjects:
  - apiVersion: v1
    kind: Secret
    metadata:
        name: traefik-dashboard-auth-secret
    type: kubernetes.io/basic-auth
    stringData:
        username: "{{ homelab.admin.username }}"
        password: "{{ homelab.admin.password }}"

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
        name: traefik-dashboard-auth
    spec:
        basicAuth:
            secret: traefik-dashboard-auth-secret

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
        name: traefik-dashboard-redirect
    spec:
        redirectRegex:
            regex: "\/traefik(\\/)?$"
            replacement: "/traefik/dashboard/"

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
        name: rate-limit
    spec:
        rateLimit:
            average: 50
            period: 1s
            burst: 50

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
        name: https-redirect
    spec:
        redirectRegex:
            regex: "^http:\/\/(.*)"
            replacement: "https://${1}"
